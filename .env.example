# Copy this file to .env and fill in real values locally. Never commit .env.

# Groq API key (https://console.groq.com/keys). Required — the LLM is mandatory
# for operator_notes interpretation per the GridWise Problem Statement.
GROQ_API_KEY=

# Groq model id used for operator-note interpretation.
GROQ_MODEL=openai/gpt-oss-120b

# Per-call timeout budget for the Groq request, in seconds. Kept short so a
# single slow call can still be retried once and still land inside the
# judge's 30s hard request timeout (Participant Guide p95 latency scoring).
LLM_TIMEOUT_SECONDS=10

# Hard ceiling for the whole POST /optimize-energy request, in seconds.
# Requests exceeding this return a controlled 500 instead of hanging past
# the judge's 30s timeout.
REQUEST_TIMEOUT_SECONDS=25

# Port the service listens on.
PORT=8000
